# Bu dosyayı kopyalayıp adını .env yapın ve değerleri doldurun.
# .env dosyası GitHub'a yüklenmez.

# MongoDB Atlas bağlantı adresi (Atlas > Connect > Drivers)
MONGODB_URI=

# Sunucunun dinleyeceği port
PORT=3000

# (İsteğe bağlı) "querySrv ECONNREFUSED" hatası alırsanız DNS sunucusu belirtin
DNS_SUNUCULARI=

# (İsteğe bağlı) API'yi tarayıcıdan çağırabilecek web adresleri, virgülle ayrılır
CORS_IZINLI_ADRESLER=

# JWT (giriş token'ı) imzalama anahtarı: uzun ve rastgele olmalı. Üretmek için:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ANAHTARI=
